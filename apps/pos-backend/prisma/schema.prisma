datasource db {
  provider = "postgresql"  
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ၁။ ဝန်ထမ်းများ (RBAC စနစ်)
enum UserRole {
  ADMIN
  CASHIER
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  role      UserRole  @default(CASHIER)
  createdAt DateTime  @default(now())
  orders          Order[]
  shiftReports    ShiftReport[] 
  sales           Sale[]
}

// ၂။ ကုန်ပစ္စည်း အမျိုးအစား
model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

// ၃။ ရောင်းချသည့်ပုံစံ
enum SaleType {
  UNIT
  WEIGHT
}

// ၄။ City Mart စံပြ ကုန်ပစ္စည်း Table
model Product {
  id                String               @id @default(uuid())
  name              String
  barcode           String               @unique // စက်ပြင် Barcode ဖတ်ရန် Unique ထားရမည်
  sku               String               @unique
  price             Float // ရောင်းဈေး
  cost              Float // ရင်းဈေး (အမြတ်တွက်ရန်)
  stockQuantity     Float                @default(0) // WEIGHT အတွက် ဒသမပါနိုင်၍ Float သုံးသည်
  saleType          SaleType             @default(UNIT)
  unitOfMeasurement String // Pcs, Kg, Pack
  isAlcohol         Boolean              @default(false)
  expiryDate        DateTime? // သက်တမ်းကုန်မည့်ရက်
  categoryId        String
  category          Category             @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  stockHistories    StockHistory[]
  branchStocks      ProductBranchStock[] // ဆိုင်အလိုက် လက်ကျန်များ ချိတ်ဆက်ခြင်း
  saleItems         SaleItem[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

// ၅။ ပစ္စည်းအဝင်/အထွက် စာရင်း (Inventory Tracking)
enum StockTransactionType {
  STOCK_IN // ပစ္စည်းအသစ်ဝင်ခြင်း
  STOCK_OUT // ရောင်းထွက်ခြင်း
  ADDING // (သို့) စာရင်းစစ်ပြီး အတိုးအလျှော့လုပ်ခြင်း
  ADJUSTMENT
}

model StockHistory {
  id              String               @id @default(uuid())
  productId       String
  product         Product              @relation(fields: [productId], references: [id])
  quantity        Int
  transactionType StockTransactionType
  reason          String? // ဥပမာ - "ဝယ်သူဝယ်ယူမှု" သို့မဟုတ် "အလှူ"
  createdAt       DateTime             @default(now())
}

// ၆။ အရောင်းဘောက်ချာ (Invoices)
model Order {
  id            String      @id @default(uuid())
  invoiceNo     String      @unique
  totalAmount   Float
  cashReceived  Float
  changeGiven   Float
  paymentMethod String      // Cash, KPay, Wave
  
  cashierId     String
  cashier       User        @relation(fields: [cashierId], references: [id])
  
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])

  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
}

// ၇။ ဘောက်ချာတစ်ခုချင်းစီ၏ အသေးစိတ် ပစ္စည်းစာရင်း
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float    // ထိုအချိန်က ရောင်းလိုက်သည့် ဈေးနှုန်း
}

// ၈။ ဆိုင်ခွဲများ (Branches) Table
model Branch {
  id        String               @id @default(uuid())
  name      String               @unique // ဥပမာ - "City Mart - Junction Square"
  code      String               @unique // ဥပမာ - "BR-YGN-01"
  address   String?
  phone     String?  

shiftReports    ShiftReport[]          
  products  ProductBranchStock[] 


   
  orders    Order[]
  sales     Sale[]               
  
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

// ဖောက်သည်အသင်းဝင်များ (Customer Loyalty & CRM)
model Customer {
  id         String    @id @default(uuid())
  name       String
  phone      String    @unique // ဖုန်းနံပါတ်ဖြင့် မန်ဘာရှာဖွေရန်
  tier       String    @default("REGULAR") // REGULAR, SILVER, GOLD, PLATINUM
  points     Float     @default(0)   // စုဆောင်းရရှိထားသော အမှတ်များ
  totalSpent Float     @default(0)   // စုစုပေါင်း ဝယ်ယူခဲ့သည့်ပမာဏ
  orders     Order[]   // ထိုဖောက်သည် ဝယ်ယူခဲ့သော ဘောက်ချာများ
  sales      Sale[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ၉။ ဆိုင်အလိုက် ကုန်ပစ္စည်းလက်ကျန် (Multi-Store Stock Tracking) Table
model ProductBranchStock {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  quantity  Float   @default(0) // ထိုဆိုင်ခွဲတွင် ရှိသော ကုန်ပစ္စည်းလက်ကျန် အရေအတွက်

  @@unique([productId, branchId]) // ပစ္စည်းတစ်ခုသည် ဆိုင်ခွဲတစ်ခုချင်းစီတွင် တစ်ကြောင်းစီသာ ရှိရမည်
}

// ၁၀။ အရောင်းဘေလ် (Sale Analytics) Model
model Sale {
  id            String      @id @default(uuid())
  invoiceNo     String      @unique // 👈 အရောင်းမှတ်တမ်းအတွက် ဘောက်ချာနံပါတ်
  totalAmount   Float
  cashReceived  Float
  changeGiven   Float
  paymentMethod String      @default("CASH")
  
  cashierId     String
  cashier       User        @relation(fields: [cashierId], references: [id])
  
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  
  saleItems     SaleItem[]  // ဘေလ်ထဲမှာပါတဲ့ ပစ္စည်းစာရင်း
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ၁၁။ ဘေလ်ထဲက ပစ္စည်းတစ်ခုချင်း (SaleItem) Model
model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  createdAt DateTime @default(now())
}

model ShiftReport {
  id            String   @id @default(uuid())
  branchId      String
  cashierId     String
  openingCash   Decimal  @db.Decimal(10, 2) @default(0)
  expectedCash  Decimal  @db.Decimal(10, 2) @default(0)
  actualCash    Decimal  @db.Decimal(10, 2) @default(0)
  difference    Decimal  @db.Decimal(10, 2) @default(0) // ပိုငွေ (+) / လိုငွေ (-)
  totalSales    Decimal  @db.Decimal(10, 2) @default(0)
  cashSales     Decimal  @db.Decimal(10, 2) @default(0)
  transferSales Decimal  @db.Decimal(10, 2) @default(0)
  status        String   @default("CLOSED") 
  createdAt     DateTime @default(now())

  branch        Branch   @relation(fields: [branchId], references: [id])
  cashier       User     @relation(fields: [cashierId], references: [id])
} 